		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static FMParameters find(boolean _forUpdate = false)
    {
        FMParameters result;

        result.selectForUpdate(_forUpdate);

        select firstonly * from result;

        if (!result)
        {
            ttsbegin;
            result.clear();
            result.initDefault();
            result.insert();
            ttscommit;

            result.selectForUpdate(_forUpdate);
            select firstonly * from result;
        }

        return result;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initDefault</Name>
				<Source><![CDATA[
    private void initDefault()
    {
        // The value in TotalsEngine field has to match one of the values
        // from the System.ComponentModel.Composition.ExportMetadataAttribute on the totals classes
        this.TotalsEngine = "Default";
    }

]]></Source>
