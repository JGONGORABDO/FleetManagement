			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;

        ret = super(_fieldIdToCheck);

        if(ret)
        {
            switch (_fieldIdToCheck)
            {
                case fieldnum(FMCarClass, NumberOfDoors):
                    if(this.NumberOfDoors < 0) 
                    {    
                        ret = checkFailed("Number of doors must be greater than 0");
                    }
                    break;

                    
                case fieldnum(FMCarClass, SeatingCapacity):
                    if(this.SeatingCapacity < 0) 
                    {
                        ret = checkFailed("Seating capacity must be greater than 0");
                    }
                    break; 
            }
        }

        return ret;
    }

]]></Source>
