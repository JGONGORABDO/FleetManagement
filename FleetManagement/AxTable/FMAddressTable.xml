		<Methods>
			<Method>
				<Name>cityStateZip</Name>
				<Source><![CDATA[
    public display str cityStateZip()
    {     
        return this.City + " " + this.State + " " + int2str(this.ZipCode); 
    }

]]></Source>
			</Method>
			<Method>
				<Name>combinedAddress</Name>
				<Source><![CDATA[
    public display str combinedAddress()
    {
        return this.AddressLine1 + " " + this.AddressLine2; 
    }

]]></Source>
			</Method>
			<Method>
				<Name>FullAddress</Name>
				<Source><![CDATA[
    public display str FullAddress()
    {
        return this.AddressLine1 + " " + this.AddressLine2 + " " + this.City + " " + this.State + " " + int2Str(this.ZipCode) + " " + this.Country;
    }

]]></Source>
			</Method>
		</Methods>
