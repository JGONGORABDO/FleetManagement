			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static FMChargeType find(FMChargeTypeId _chargeTypeId, boolean _forupdate = false)
    {
        FMChargeType result;

        result.selectForUpdate(_forupdate);
        
        select firstonly result where result.ChargeType == _chargeTypeId;

        return result;
    }

]]></Source>
