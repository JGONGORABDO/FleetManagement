			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {

        this.setDisplayRelationType();

        super();

        if (infolog.globalCache().get('FleetSample', 'InsertOrderInfo', false))
        {
            info(strFmt('%1 inserted: recID %2', Global::tableId2Name(this.TableId),this.RecId));
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>setDisplayRelationType</Name>
				<Source><![CDATA[
    private void setDisplayRelationType()
    {
        DictEnum enumType = new DictEnum(enumNum(FMVehicle_DisplayRelationType));
        int enumValue;

        if (this.DisplayRelationType != FMVehicle_DisplayRelationType::Unknown)
        {
            return;
        }

        enumValue = enumType.symbol2Value(this.getInstanceRelationType());
        if (enumValue == 255) // symbol2Value returns 255 if cannot convert
        {
            throw error(strFmt('No %1 enum element found for EnumValue %2',
                enumStr(FMVehicle_DisplayRelationType),
                this.getInstanceRelationType()));
        }
        else
        {
            this.DisplayRelationType = enumValue;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>OMInternalOrganization</Name>
				<Source><![CDATA[
    public OMInternalOrganization OMInternalOrganization(OMInternalOrganization _relatedTable = null)
