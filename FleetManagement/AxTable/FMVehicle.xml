			<Method>
				<Name>FMVehicleModel</Name>
				<Source><![CDATA[
    public FMVehicleModel FMVehicleModel(FMVehicleModel _relatedTable = null)
    {
        if (prmIsDefault(_relatedTable))
        {
            return this.setLink('FMVehicleModel');
        }
        else
        {
            // Bug 3135762: setLink does not seem to work
            this.VehicleModel = _relatedTable.RecId;
            return this.setLink('FMVehicleModel', _relatedTable);
        }
    }

]]></Source>
