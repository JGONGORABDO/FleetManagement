			<Method>
				<Name>templateName</Name>
				<Source><![CDATA[
    /// <summary>
    /// Sets or gets the information of the <c>AccountingDistributionTemplate</c> record for the creation of distributions.
    /// </summary>
    /// <param name="_set">
    /// The indicator whether it is update.
    /// </param>
    /// <param name="_templateName">
    /// The name of the accounting distribution template to be used to create distributions.
    /// </param>
    /// <returns>
    /// The name of the accounting distribution template.
    /// </returns>
    // BP Deviation Documented
    public edit TemplateName templateName(boolean _set, TemplateName _templateName)
    {
        TemplateName                        templateName = "";

        if (_set)
        {
            if (_templateName == "")
            {
                this.AccountingDistributionTemplate = 0;
            }
        }

        return templateName;
    }

]]></Source>
			</Method>
			<Method>
				<Name>FMChargeType</Name>
				<Source><![CDATA[
    public FMChargeType FMChargeType(FMChargeType _relatedTable = null)
    {
        if (prmIsDefault(_relatedTable))
        {
            return this.setLink('FMChargeType');
        }
        else
        {
            // Bug 3135762: setLink does not seem to work
            this.initFromChargeType(_relatedTable);
            return this.setLink('FMChargeType', _relatedTable);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>FMRental</Name>
				<Source><![CDATA[
    public FMRental FMRental(FMRental _relatedTable = null)
    {
        if (prmIsDefault(_relatedTable))
        {
            return this.setLink('FMRental');
        }
        else
        {
            // Bug 3135762: setLink does not seem to work
            this.RentalId = _relatedTable.RentalId;
            return this.setLink('FMRental', _relatedTable);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldnum(FMRentalCharge, Quantity):
            case fieldnum(FMRentalCharge, PerUnitAmount):
                this.ExtendedAmount = this.Quantity * this.PerUnitAmount;
                break;
            case fieldnum(FMRentalCharge, ChargeType):
                this.initFromChargeType(FMChargeType::find(this.ChargeType));
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromChargeType</Name>
				<Source><![CDATA[
    public void initFromChargeType(FMChargeType _chargeType)
    {
        this.ChargeType = _chargeType.ChargeType;
        this.Description = _chargeType.Description;
        this.PerUnitAmount = _chargeType.PerUnitAmount;
        if (_chargeType.DefaultQuantity)
        {
            this.Quantity = _chargeType.DefaultQuantity;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();
        this.Quantity = 1;
    }

]]></Source>
