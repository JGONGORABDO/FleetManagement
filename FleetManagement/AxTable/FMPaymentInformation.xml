		<Methods>
			<Method>
				<Name>creditExpiration</Name>
				<Source><![CDATA[
    public display FMPaymentCreditExpiration creditExpiration()
    {
        return this.ExpirationMonth + "/" + int2str(this.ExpirationYear); 
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;
        int value;
        int currentYear;

        ret = super(_fieldIdToCheck);

        if(ret)
        {
            switch (_fieldIdToCheck)
            {
                case fieldnum(FMPaymentInformation, CCN):
                    if(str2int64(this.CCN) <= 0 || strlen(this.CCN) != 16) 
                    {
                        ret = checkFailed("Credit card must be a 16-digit number");
                    }
                    break; 

                case fieldnum(FMPaymentInformation,CVV): 
                    if(str2int64(this.CVV) <= 0 || strlen(this.CVV) != 3) 
                    {
                        ret = checkFailed("CVV mustbe a 3-digit number");
                    }
                    break;

                case fieldnum(FMPaymentInformation, ExpirationMonth):
                    value = str2int(this.ExpirationMonth); 
                    if(value < 1 || value > 12) 
                    {
                        ret = checkFailed("Expiration month must be a valid month (1-12)");
                    }
                    break;

                case fieldnum(FMPaymentInformation, ExpirationYear):                    
                
                    currentYear = DateTimeUtil::year(DateTimeUtil::getSystemDateTime());

                    if(this.ExpirationYear < currentYear || this.ExpirationYear > currentYear+10)
                    {
                        ret = checkFailed("Expiration year must be between " + int2str(currentYear) + " and " + int2str(currentYear + 10));
                    }
                    break;

            }
        }

        return ret;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
