			<Method>
				<Name>setWorkflowStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// Sets the workflow status for an action state.
    /// </summary>
    /// <param name="_fmvRecId">
    /// The record ID of the <c>FMVehicleMaintenance</c> record for which to set the workflow status.
    /// </param>
    /// <param name="__workflowApprovalStatus">
    /// The workflow status to set.
    /// </param>
    public static void setWorkflowStatus(
        RecId                       _fmvRecId,
        FMStatus                    _workflowStatus)
    {
        FMVehicleMaintenance  fMVehicleMaintenance;

        select forupdate  fMVehicleMaintenance where fMVehicleMaintenance.RecId == _fmvRecId;
        if(fMVehicleMaintenance)
        {        
            ttsbegin;
            fMVehicleMaintenance.Status   = _workflowStatus;
            fMVehicleMaintenance.update();
            ttscommit;
        }        
    }

]]></Source>
