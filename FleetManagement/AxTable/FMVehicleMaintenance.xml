				<Source><![CDATA[
    public FMVehicle FMVehicle(FMVehicle _relatedTable = null)
    {
        if (prmIsDefault(_relatedTable))
        {
            return this.setLink('FMVehicle');
        }
        else
        {
            // Bug 3135762: setLink does not seem to work
            this.VehicleRelation = _relatedTable.RecId;
            return this.setLink('FMVehicle', _relatedTable);
        }
    }

]]></Source>
