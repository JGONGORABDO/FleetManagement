{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>vehiclePrices</Name>
				<Source><![CDATA[
    public display FMName vehiclePrices()
    {
        return int2str(real2int(this.RatePerDay)) + '/day'; 
    }

]]></Source>
			</Method>
			<Method>
				<Name>getRate</Name>
				<Source><![CDATA[
    public static container getRate(FMVehicleRecId vehicle)
    {
        FMModelRate modelRate;
        FMVehicle vehicleTable;
        FMVehicleModel vehicleModelTable;
        container result = connull();

        if (vehicle)
        {
            select RatePerDay, RatePerWeek from modelRate
                join vehicleModelTable
                join vehicleTable
                where vehicleModelTable.RecId == modelRate.MakeModelId &&
                    vehicleTable.VehicleModel == vehicleModelTable.RecId &&
                    vehicleTable.RecId == vehicle;

            result = [modelRate.RatePerDay, modelRate.RatePerWeek];
        }
        return result;
    }

]]></Source>
			</Method>
		</Methods>
