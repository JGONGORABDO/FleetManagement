                qds.addSelectionFieldWithAlias(#AliasCategory, fieldNum(FMCustomerActivity, VehicleModel));
                qds.addGroupByField(fieldNum(FMCustomerActivity, VehicleModel));

                // View filter: CustomerID
                QueryBuildRange qbr = qds.addRange(fieldnum(FMCustomerActivity, CustomerID));
                qbr.value(int642Str(fmCustomer.RecId));

                // run the query and insert the query results into the form datasource
