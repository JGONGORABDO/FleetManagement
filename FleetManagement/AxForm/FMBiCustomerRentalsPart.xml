				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            // empty the temporary data set
            delete_from FMCustomerRentalsByColorTmp;

            try
            {
                SysQueryRun::ExecuteInManagedStack(true);

                Query q = new Query();

                // query an aggregate entity and select desired measures
                QueryBuildDataSource  qds = q.addDataSource(tableNum(FMCustomerActivity));
                qds.addSelectionFieldWithAlias(#AliasNoRentals, fieldNum(FMCustomerActivity, NoRentals), SelectionField::Count);
                qds.addSelectionFieldWithAlias(#AliasCategory, fieldNum(FMCustomerActivity, VehicleColor));
                qds.addGroupByField(fieldNum(FMCustomerActivity, VehicleColor));

                // View filter: CustomerID
                QueryBuildRange qbr = qds.addRange(fieldnum(FMCustomerActivity, CustomerID));
                qbr.value(int642Str(fmCustomer.RecId));
                
                // run the query and insert the query results into the form datasource
                Map m = new Map(Types::String, Types::String);
                m.insert(#AliasCategory, fieldStr(FMCustomerRentalsByColorTmp, FMColorName));
                m.insert(#AliasNoRentals, fieldStr(FMCustomerRentalsByColorTmp, NoRentals));

                int rowCount = QueryRun::runAndPopulate(q, FMCustomerRentalsByColorTmp, m);
            }
            finally
            {
                SysQueryRun::ExecuteInManagedStack(false);
            }

            super();

        }

]]></Source>
