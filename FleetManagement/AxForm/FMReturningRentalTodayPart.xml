			<Control>
				<Name>CompleteRentalButton</Name>
				<Type>MenuFunctionButton</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {            
            FMVehicle vehicle;
            FMRental rental;
            
            select firstonly rental where rental.RentalId == FMPickupAndReturnTable.RentalId;
            select forupdate vehicle where vehicle.RecId == rental.Vehicle;
            
            // If vehicle is not rented then it cannot be returned
            if(vehicle.Status != FMVehicleStatus::Rented)
            {
                warning('This vehicle has already been returned.');
                FMRental.State = FMReservationState::Complete;
                FMRental_DS.research(true);                
            }
            else
            {
                super(); 
            }
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
