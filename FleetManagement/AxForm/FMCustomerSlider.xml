				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {

            //Tie the address record to the payment info record
            FMCustomer.AddressID = FMAddressTable.RecId;
            element.setCustomerOnCaller(FMCustomer);
            super();
        }

]]></Source>
					</Method>
