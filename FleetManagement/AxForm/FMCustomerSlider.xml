			<Method>
				<Name>setCustomerOnCaller</Name>
				<Source><![CDATA[
    /// <summary>
    /// Sets the customer reference if this form is being called from NewReservation
    /// </summary>
    private void setCustomerOnCaller(FMCustomer _customer)
    {
        IFMNewReservation callerForm = element.args().caller() as IFMNewReservation;

        if (callerForm)
        {            
            callerForm.setCustomer(_customer);
        }

    }

]]></Source>
			</Method>
