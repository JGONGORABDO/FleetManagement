				<Source><![CDATA[
    /// <summary>
    /// Sets the customer in referencecontrol if new customer has been created
    /// </summary>
    public void setCustomer(FMCustomer _customer)
    {
        FormDataObject formfield;
        customer = _customer;
        if(customer)
        {
            formfield = FMRental_DS.object(fieldnum(FMRental, Customer));
            formfield.setValue( customer.RecId);
            FMRental_DS.rereadReferenceDataSources();
        }
        
    }

]]></Source>
