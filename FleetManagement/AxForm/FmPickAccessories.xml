				<Source><![CDATA[
[Form]
public class FMPickAccessories extends FormRun
{
    FMRentalCharge rentalCharge;
    FmRental rental; 
    FormDataSource rentalDS; 

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        //If this form was opened with a Rental as context then 
        if(element.args() != null && element.args().record() != null) 
        {
            if(element.args().record().TableId == tablenum(FMRental))
            {
                //Grab that Rental context
                rental = element.args().record();
                rentalDS = FormDataUtil::getFormDataSource(element.args().record());
                rentalCharge.initValue();
                rentalCharge.FMRental(rental);

                //Clear the rental context
                element.args().record(null); 
            }
        }

        super();

    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="" />
		<DataControls xmlns="">
			<Control>
				<Name>OkButton</Name>
				<Type>CommandButton</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            // Log Xpp Transaction discrete event
            Microsoft.Dynamics.Application.Instrumentation.FleetManagementEventSource::EventWriteXppTransactionStart("FleetManagement", "Pick an accessory");

            super();

            if(rental != null)
            {
                //Create link between rental and addon
                rentalCharge.FMChargeType(FMChargeType);
                rentalCharge.insert();

                //Update calling form and position to new record
                rentalDS.research(true); 
            }
            
            Microsoft.Dynamics.Application.Instrumentation.FleetManagementEventSource::EventWriteXppTransactionStop("FleetManagement", "Pick an accessory");
        }

]]></Source>
					</Method>
