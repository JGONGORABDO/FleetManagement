				<Name>ValidatePaymentInformation</Name>
				<Source><![CDATA[
    /// <summary> 
    /// OData Service Action to validate the payment information, updating its state after execution.
    /// 
    /// As an example of a stateful action, we are assuming that this action can only be done after validating
    /// it is not already approved.  The second attribute being false means that only in certain states will this
    /// action be exposed, and the thrid attribute provides the method to determine the state.
    /// </summary>
    [SysODataActionAttribute("Validate", true)]
    public boolean ValidatePaymentInformation()
    {
        // Note, all actions are already wrapped in a transactions: no need to ttsbegin/commit or .Write()
        if (!this.ValidateCanValidatePaymentInformation())
        {
            // The framework does not call the validate except when WCF Data Services is requesting information about 
            // whether to expose the action publicly in metadata.  However, whether exposed or not, someone who knows
            // the url to invoke the action and the parameters to pass in can ALWAYS invoke the action.  To prevent the 
            // use of actions during invalid state, they should use their validate method again when the action is 
            // executed and handle on bad state appropriately.  
            return false;
        }

        this.State = FMPaymentState::Approved;
        // Deliverable 3135766: plug into some more complex algorithm to approve the credit card
        
        return true; // return true if successful update
    }

]]></Source>
			</Method>
			<Method>
				<Name>ValidateCanValidatePaymentInformation</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns true if valid (State of the payment is set and is not already approved).  Otherwise, returns false if approved.
    /// </summary>
    public boolean ValidateCanValidatePaymentInformation()
    {
        // Because this could be a projection of only certain fields, first ensure that this field is actually set
        //if (this.fieldState(fieldname2id(tablename2id("PaymentInformation"), "State")) != FieldState::NotSet)
        // {
        if (this.State != FMPaymentState::Approved)
        {
            return true;
        }
        // }
        return false;
    }

]]></Source>
			</Method>
