			<Method>
				<Name>FMNumVehiclesAvailable</Name>
				<Source><![CDATA[
    /// <summary>
    /// Retrieves the number of Available vehicles
    /// </summary>
    /// <returns>
    /// An expression number of Available vehicles
    /// </returns>
    public static str FMNumVehiclesAvailable()
    {
        // CREATE MEMBER CURRENTCUBE.[Available] AS sum([Measures].[NoVehicles], [FMVehicle].[VehicleStatus].&[1])

        TableName       viewName = tableStr(FMVehicleExtendedView);

        List            transTypeList = new List(Types::String);

        return SysComputedColumn::if(
            SysComputedColumn::equalExpression(
                SysComputedColumn::comparisonField(viewName, identifierStr(FMVehicle) , fieldStr(FMVehicle, Status)),
                SysComputedColumn::comparisonLiteral(enum2int(FMVehicleStatus::Available))),
                SysComputedColumn::returnLiteral(1),
                SysComputedColumn::returnLiteral(0));
    }

]]></Source>
			</Method>
