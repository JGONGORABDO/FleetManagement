		<Methods>
			<Method>
				<Name>GetColorsByAvailability</Name>
				<Source><![CDATA[
    /// <summary> 
    /// OData Action: GetColorsByAvailability
    /// 
    /// Returns all Colors available to this MakeModel.
    /// </summary>
    [SysODataActionAttribute("GetColors", true),
     SysODataCollectionAttribute("return", Types::Record, "CarColor")]
    public List GetColorsByAvailability(boolean onlyAvailableVehicles)
    {
        Vehicle vehicle;
        CarColor color;
        Map colorNameMap = new Map(Types::String, Types::Record);
        int64 thisRecId = this.RecId;
        List returnList = new List(Types::Record);
        while select vehicle where 
            vehicle.Status == FMVehicleStatus::Available && 
            vehicle.VehicleModel == thisRecId
        {
            select color where color.RecId == vehicle.ColorID;
            if (!colorNameMap.exists(color.HexValue))
            {
                colorNameMap.insert(color.HexValue, color);
                returnList.addEnd(color);
            }
        }
        return returnList;
    }

]]></Source>
			</Method>
